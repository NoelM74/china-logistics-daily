---
import { SITE, TAGS, SERVICE_LINKS, href } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="no-print mt-20 border-t-2 border-ink bg-paper-sunk">
  <div class="wrap grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-4">
    <div class="sm:col-span-2 lg:col-span-1">
      <p class="font-display text-xl font-bold tracking-[-0.02em]">
        China Logistics <span class="text-jade-500">Daily</span>
      </p>
      <p class="mt-3 max-w-sm text-sm leading-relaxed text-ink-muted">
        A daily briefing on China freight, tariffs and ecommerce fulfilment, written
        for the people who actually have stock on the water. Published every morning
        at {SITE.publishHour} Irish time.
      </p>
      <p class="dateline mt-4">
        Written by <a href={href('/about')} class="dateline-link text-ink-muted">{SITE.author.name}</a>
      </p>
    </div>

    <nav aria-labelledby="ft-site">
      <h2 id="ft-site" class="dateline mb-3 !text-ink">The site</h2>
      <ul class="space-y-2 text-sm">
        <li><a href={href('/')} class="list-link">Today's briefing</a></li>
        <li><a href={href('/archive')} class="list-link">Archive</a></li>
        <li><a href={href('/topics')} class="list-link">All topics</a></li>
        <li><a href={href('/about')} class="list-link">About</a></li>
        <li><a href={href('/subscribe')} class="list-link">Get it by email</a></li>
        <li><a href="/rss.xml" class="list-link">RSS feed</a></li>
      </ul>
    </nav>

    <nav aria-labelledby="ft-topics">
      <h2 id="ft-topics" class="dateline mb-3 !text-ink">Topics</h2>
      <ul class="space-y-2 text-sm">
        {
          TAGS.slice(0, 8).map((t) => (
            <li>
              <a href={href(`/topics/${t.slug}`)} class="list-link">{t.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-labelledby="ft-services">
      <h2 id="ft-services" class="dateline mb-3 !text-ink">We also ship your stock</h2>
      <ul class="space-y-2 text-sm">
        {
          SERVICE_LINKS.map((s) => (
            <li>
              <a href={s.url} class="list-link">{s.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="border-t border-rule">
    <div
      class="wrap flex flex-col gap-2 py-5 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="dateline">
        &copy; {year} {SITE.parent.name}. Shenzhen &middot; Zhengzhou &middot; Ireland.
      </p>
      <p class="dateline">
        <a href={SITE.parent.url} class="dateline-link text-ink-muted">china-fulfillment.com</a>
        <span aria-hidden="true"> &middot; </span>
        <a href={SITE.sister.url} class="dateline-link text-ink-muted">eriusourcing.com</a>
      </p>
    </div>
  </div>
</footer>
