---
export interface Props {
  hooks: string[];
}
const { hooks } = Astro.props;
---

{/*
  The newsjacking payload. These are angles a reader lifts for their own
  LinkedIn post or newsletter, which is the reason to bookmark the site.
  Two columns on desktop because the list runs long and a single column
  pushes the FAQ below the fold.
*/}
<section aria-labelledby="hooks-h" class="mt-14">
  <div class="rule-jade mb-5 border-t-2" />
  <h2 id="hooks-h" class="text-[1.5rem] sm:text-[1.75rem]">Content hooks</h2>
  <p class="measure mt-2 text-ink-muted">
    Angles from today's stories, ready to turn into a post, a video or a note to
    your list. Take them. That is what they are for.
  </p>

  <ol class="mt-6 grid gap-x-10 gap-y-3 md:grid-cols-2">
    {
      hooks.map((hook, i) => (
        <li class="flex gap-3 border-b border-rule pb-3">
          <span class="dateline tnum mt-[0.35em] shrink-0">{String(i + 1).padStart(2, '0')}</span>
          <span class="text-[0.975rem] leading-relaxed">{hook}</span>
        </li>
      ))
    }
  </ol>
</section>
