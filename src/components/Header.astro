---
import { SITE, href, formatDate } from '../data/site';

export interface Props {
  latestDate?: string;
}
const { latestDate } = Astro.props;
const path = Astro.url.pathname;

const nav = [
  { label: 'Today', href: href('/') },
  { label: 'Archive', href: href('/archive') },
  { label: 'Topics', href: href('/topics') },
  { label: 'About', href: href('/about') },
];

const isCurrent = (h: string) => (h === '/' ? path === '/' : path.startsWith(h));
---

<header
  class="no-print sticky top-0 z-40 border-b border-rule bg-paper/90 backdrop-blur-sm"
>
  {/* Row 1 — masthead + dateline */}
  <div class="wrap flex items-baseline justify-between gap-4 pt-3 pb-2">
    <a href={href('/')} class="no-underline">
      <span
        class="font-display text-[1.35rem] leading-none font-bold tracking-[-0.02em] sm:text-[1.6rem]"
      >
        China Logistics <span class="text-jade-500">Daily</span>
      </span>
    </a>

    <p class="dateline hidden shrink-0 text-right sm:block">
      {latestDate ? formatDate(latestDate) : `Every morning, ${SITE.publishHour} Irish time`}
    </p>
  </div>

  {/* Row 2 — nav + parent-brand attribution */}
  <div class="wrap flex items-center justify-between gap-4 border-t border-rule py-1.5">
    <nav aria-label="Primary">
      <ul class="flex items-center gap-4 sm:gap-5">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
                class:list={[
                  'dateline dateline-link transition-colors hover:text-jade-600',
                  isCurrent(item.href) && '!text-jade-600',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a
      href={SITE.parent.url}
      class="dateline dateline-link hidden transition-colors hover:text-jade-600 md:inline-flex"
    >
      A service of china&#8209;fulfillment.com
    </a>
  </div>
</header>
