---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StoryBlock from '../../components/StoryBlock.astro';
import BottomLine from '../../components/BottomLine.astro';
import ContentHooks from '../../components/ContentHooks.astro';
import Faq from '../../components/Faq.astro';
import TrustPanel from '../../components/TrustPanel.astro';
import BriefingCard from '../../components/BriefingCard.astro';
import { allBriefings, relatedBriefings, briefingTags, type Briefing } from '../../data/briefings';
import { SITE, href, formatDate, publishedISO, assignCtas, getTag } from '../../data/site';
import { heroBand } from '../../data/hero';

export const getStaticPaths: GetStaticPaths = async () => {
  const briefings = await allBriefings();
  return briefings.map((entry) => ({
    params: { date: entry.data.date },
    props: { entry, pool: briefings },
  }));
};

interface Props {
  entry: Briefing;
  pool: Briefing[];
}

const { entry, pool } = Astro.props;
const b = entry.data;
const path = `/briefing/${b.date}`;
const ctas = assignCtas(b.stories);
const related = relatedBriefings(entry, pool, 3);
const tags = briefingTags(entry);
const isLatest = pool[0]?.id === entry.id;
---

<BaseLayout
  title={b.title}
  description={b.metaDescription}
  path={path}
  latestDate={b.date}
  ogImage={`/og/${b.date}.png`}
  article={{
    headline: b.title,
    datePublished: publishedISO(b.date),
    section: 'Logistics',
    keywords: tags,
    topics: tags.flatMap((slug) => {
      const t = getTag(slug);
      return t ? [{ slug: t.slug, name: t.label }] : [];
    }),
  }}
  faq={b.faq}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Archive', path: '/archive' },
    { name: formatDate(b.date), path },
  ]}
>
  <div class="wrap py-8 sm:py-12">
    <nav aria-label="Breadcrumb" class="dateline mb-6">
      <a href={href('/')} class="dateline-link">Home</a>
      <span aria-hidden="true"> / </span>
      <a href={href('/archive')} class="dateline-link">Archive</a>
      <span aria-hidden="true"> / </span>
      <span aria-current="page">{formatDate(b.date)}</span>
    </nav>

    <article class="reveal">
      {/*
        Decorative route band, inlined. aria-hidden on purpose: it carries no
        information about the day's news, and giving a decorative graphic
        keyword alt text is stuffing, which helps nobody and hurts screen
        reader users. See README "Images".
      */}
      <div class="mb-8 h-20 overflow-hidden rounded-[2px] sm:h-28" set:html={heroBand(b.date, 5)} />

      <header class="lg:pl-0">
        <div class="dateline flex flex-wrap items-center gap-x-2 gap-y-1">
          <time datetime={publishedISO(b.date)}>{formatDate(b.date)}</time>
          <span aria-hidden="true">&middot;</span>
          <span>{b.stories.length} stories</span>
          <span aria-hidden="true">&middot;</span>
          <span>By {SITE.author.name}</span>
          {isLatest && (
            <>
              <span aria-hidden="true">&middot;</span>
              <span class="text-flag">Today’s briefing</span>
            </>
          )}
        </div>

        <h1 class="mt-3 text-[2.1rem] leading-[1.06] sm:text-[2.9rem] lg:text-[3.2rem]">
          {b.title}
        </h1>

        <div class="mt-6">
          <BottomLine text={b.bottomLine} variant="lede" />
        </div>
      </header>

      {/* Stories. The left padding on large screens makes room for the hanging
          accent numerals without pushing the reading column off-centre. */}
      <div class="mt-12 space-y-16 lg:mt-14 lg:space-y-20 lg:pl-[4.5rem]">
        {b.stories.map((story, i) => <StoryBlock index={i} story={story} cta={ctas[i]!} />)}
      </div>

      <ContentHooks hooks={b.contentHooks} />
      <Faq faq={b.faq} />

      <section class="mt-14">
        <div class="rule-accent mb-5 border-t-2" />
        <h2 class="text-[1.5rem] sm:text-[1.75rem]">The bottom line</h2>
        <div class="mt-5">
          <BottomLine text={b.bottomLine} variant="close" />
        </div>
      </section>

      <TrustPanel />
    </article>

    {
      related.length > 0 && (
        <section aria-labelledby="related-h" class="mt-16">
          <div class="rule-thick mb-1 border-t-[3px]" />
          <h2 id="related-h" class="mt-4 text-[1.35rem]">Related briefings</h2>
          <div class="mt-4">
            {related.map((r) => (
              <BriefingCard
                date={r.data.date}
                title={r.data.title}
                bottomLine={r.data.bottomLine}
                storyCount={r.data.stories.length}
                tags={briefingTags(r)}
              />
            ))}
          </div>
          <p class="mt-6">
            <a href={href('/archive')} class="inline-cta">Every briefing we have published</a>
          </p>
        </section>
      )
    }

    {
      tags.length > 0 && (
        <section aria-labelledby="topics-h" class="mt-12">
          <h2 id="topics-h" class="dateline !text-ink mb-3">Topics in this briefing</h2>
          <ul class="flex flex-wrap gap-1.5">
            {tags.map((slug) => {
              const t = getTag(slug);
              return t ? (
                <li>
                  <a href={href(`/topics/${t.slug}`)} class="tag-pill">
                    {t.label}
                  </a>
                </li>
              ) : null;
            })}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>
