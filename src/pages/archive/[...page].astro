---
import type { GetStaticPaths, Page } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BriefingCard from '../../components/BriefingCard.astro';
import { allBriefings, briefingTags, type Briefing } from '../../data/briefings';
import { SITE, href, TAGS } from '../../data/site';

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const briefings = await allBriefings();
  return paginate(briefings, { pageSize: 20 });
};

interface Props {
  page: Page<Briefing>;
}

const { page } = Astro.props;
const latest = page.data[0];
const pageLabel = page.currentPage > 1 ? `, page ${page.currentPage}` : '';
---

<BaseLayout
  title={`Briefing archive${pageLabel} | China Logistics Daily`}
  description={`Every China logistics briefing we have published, newest first. Freight rates, tariffs, customs and Amazon FBA news for ecommerce sellers shipping from China.`}
  path={page.currentPage === 1 ? '/archive' : `/archive/${page.currentPage}`}
  latestDate={latest?.data.date}
  noindex={page.currentPage > 1}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Archive', path: '/archive' },
  ]}
>
  <div class="wrap py-8 sm:py-12">
    <nav aria-label="Breadcrumb" class="dateline mb-6">
      <a href={href('/')} class="dateline-link">Home</a>
      <span aria-hidden="true"> / </span>
      <span aria-current="page">Archive</span>
    </nav>

    <header class="reveal">
      <h1 class="text-[2.1rem] leading-[1.06] sm:text-[2.8rem]">Briefing archive</h1>
      <p class="measure mt-4 text-[1.05rem] leading-relaxed text-ink-muted">
        Every briefing, newest first. {page.total} in total, published daily since we started.
        If you are looking for a specific topic rather than a specific day, the
        <a href={href('/topics')}>topic hubs</a> are the faster route.
      </p>
    </header>

    <div class="mt-10">
      {
        page.data.map((b) => (
          <BriefingCard
            date={b.data.date}
            title={b.data.title}
            bottomLine={b.data.bottomLine}
            storyCount={b.data.stories.length}
            tags={briefingTags(b)}
            level={2}
          />
        ))
      }
      <div class="border-t border-rule-strong" />
    </div>

    {
      (page.url.prev || page.url.next) && (
        <nav aria-label="Pagination" class="mt-10 flex items-center justify-between gap-4">
          {page.url.prev ? (
            <a href={href(page.url.prev)} class="btn btn-ghost" rel="prev">
              &larr; Newer
            </a>
          ) : (
            <span />
          )}
          <span class="dateline tnum">
            Page {page.currentPage} of {page.lastPage}
          </span>
          {page.url.next ? (
            <a href={href(page.url.next)} class="btn btn-ghost" rel="next">
              Older &rarr;
            </a>
          ) : (
            <span />
          )}
        </nav>
      )
    }

    <section aria-labelledby="browse-h" class="mt-16">
      <div class="rule-accent mb-5 border-t-2" />
      <h2 id="browse-h" class="text-[1.35rem]">Browse by topic</h2>
      <ul class="mt-4 flex flex-wrap gap-1.5">
        {
          TAGS.map((t) => (
            <li>
              <a href={href(`/topics/${t.slug}`)} class="tag-pill">
                {t.label}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="dateline mt-6">
        Shipping from China? <a href={SITE.parent.contact} class="text-ink-muted">Talk to us.</a>
      </p>
    </section>
  </div>
</BaseLayout>
