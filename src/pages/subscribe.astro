---
import BaseLayout from '../layouts/BaseLayout.astro';
import { allBriefings } from '../data/briefings';
import { SITE, href } from '../data/site';

const briefings = await allBriefings();
const latest = briefings[0];
---

{
  /*
    Email capture is Phase 2 (PRD §12) — there is no list, no ESP and no send
    yet. Rather than ship a form that silently drops addresses, this page offers
    the two channels that work today (RSS, and just reading it) and says plainly
    that email is coming. Wiring a real form in later is a small change to this
    file. noindex until it does something, so it cannot rank as a dead end.
  */
}

<BaseLayout
  title="Get the briefing | China Logistics Daily"
  description="How to follow the daily China logistics briefing: RSS today, email shortly."
  path="/subscribe"
  latestDate={latest?.data.date}
  noindex
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Subscribe', path: '/subscribe' },
  ]}
>
  <div class="wrap py-8 sm:py-12">
    <nav aria-label="Breadcrumb" class="dateline mb-6">
      <a href={href('/')} class="dateline-link">Home</a>
      <span aria-hidden="true"> / </span>
      <span aria-current="page">Subscribe</span>
    </nav>

    <div class="measure reveal">
      <h1 class="text-[2.1rem] leading-[1.06] sm:text-[2.8rem]">Get the briefing</h1>
      <p class="mt-4 text-[1.075rem] leading-relaxed text-ink-muted">
        A new briefing goes up every morning at {SITE.publishHour} Irish time, seven days a
        week. Here is how to make sure you see it.
      </p>

      <section aria-labelledby="rss-h" class="card-edge mt-10">
        <p class="section-label mb-2">Available now</p>
        <h2 id="rss-h" class="text-[1.3rem]">RSS</h2>
        <p class="mt-2 text-ink-muted">
          Every briefing, full summary, in whatever reader you already use.
        </p>
        <p class="mt-3">
          <a href="/rss.xml" class="inline-cta">chinalogisticsdaily.com/rss.xml</a>
        </p>
      </section>

      <section aria-labelledby="email-h" class="mt-8 border border-rule-strong p-6">
        <p class="section-label mb-2">Coming shortly</p>
        <h2 id="email-h" class="text-[1.3rem]">The daily email</h2>
        <p class="mt-2 text-ink-muted">
          Same briefing, in your inbox before you have opened anything else. The list is not
          live yet, and we would rather say that than take your address and sit on it. If you
          want to be on it from day one, send us a line and we will add you.
        </p>
        <p class="mt-4">
          <a href={SITE.parent.contact} class="btn btn-primary">Ask to be added</a>
        </p>
      </section>

      <p class="dateline mt-10">
        No pop-ups, no paywall, no list you have to join to read it.
        <a href={href('/')} class="text-ink-muted">Today’s briefing</a> is right here.
      </p>
    </div>
  </div>
</BaseLayout>
